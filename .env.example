# Copy this file to .env and fill in the blanks. Never commit .env.

# --- MySQL connection ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=portfolio

# Admin account used ONLY by the setup scripts (create database, load data,
# create the read-only user). Usually root.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Read-only account the app / MCP server will use. Choose a new strong password;
# data/create_reader_user.py creates the account with it.
ASSISTANT_DB_USER=assistant_reader
ASSISTANT_DB_PASSWORD=

# Restricted read-only account for the Viewer role: SELECT on every portfolio table
# except deals. Choose a new strong password; data/create_viewer_user.py creates it.
ASSISTANT_VIEWER_DB_USER=assistant_viewer
ASSISTANT_VIEWER_DB_PASSWORD=

# --- Query log (Phase 4 backend) ---
# INSERT-only account the backend uses to write one row per /chat request into
# QUERY_LOG_DATABASE.query_log. Choose a new strong password;
# data/create_logger_user.py creates the database, table and account with it.
QUERY_LOG_DATABASE=assistant_logs
QUERY_LOGGER_USER=query_logger
QUERY_LOGGER_PASSWORD=

# --- Document storage (Phase 6) ---
# Azure Blob Storage connection string. "UseDevelopmentStorage=true" = local Azurite emulator.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# --- Sign-in (Phase 7) ---
# Secret that signs the login tokens: at least 32 random characters. Generate one with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a sign-in lasts, in minutes (default 60, max 1440).
JWT_EXPIRE_MINUTES=60

# Two demo users. Password hashes are bcrypt; generate each one with:
#   .venv\Scripts\python.exe -m backend.hash_password
# Keep the single quotes around the hash (it contains $ characters).
ANALYST_USERNAME=analyst
ANALYST_PASSWORD_HASH=''
ANALYST_DISPLAY_NAME=Demo Analyst
VIEWER_USERNAME=viewer
VIEWER_PASSWORD_HASH=''
VIEWER_DISPLAY_NAME=Demo Viewer

# --- Usage export (Phase 8, data/export_query_log.py) ---
# Read-only account with SELECT on QUERY_LOG_DATABASE.query_log and nothing else.
# Choose a new strong password; data/create_log_reader_user.py creates the account with it.
QUERY_LOG_READER_USER=query_log_reader
QUERY_LOG_READER_PASSWORD=

# --- Accuracy evaluation (Phase 8, tests/eval/run_eval.py) ---
# The plain-text passwords of the demo users above (the evaluation signs in through POST /login).
# EVAL_USERNAME must be the Analyst. The Viewer pair is used only for the one Viewer-restricted
# question; leave it blank to skip that question.
EVAL_USERNAME=analyst
EVAL_PASSWORD=
EVAL_VIEWER_USERNAME=viewer
EVAL_VIEWER_PASSWORD=
# Optional: where the backend is running (default http://127.0.0.1:8000).
# EVAL_BASE_URL=http://127.0.0.1:8000
