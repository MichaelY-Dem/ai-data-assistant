# Copy this file to .env and fill in the blanks. Never commit .env.

# --- MySQL connection ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=portfolio

# Admin account used ONLY by the setup scripts (create database, load data,
# create the read-only user). Usually root.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Read-only account the app / MCP server will use. Choose a new strong password;
# data/create_reader_user.py creates the account with it.
ASSISTANT_DB_USER=assistant_reader
ASSISTANT_DB_PASSWORD=

# --- Query log (Phase 4 backend) ---
# INSERT-only account the backend uses to write one row per /chat request into
# QUERY_LOG_DATABASE.query_log. Choose a new strong password;
# data/create_logger_user.py creates the database, table and account with it.
QUERY_LOG_DATABASE=assistant_logs
QUERY_LOGGER_USER=query_logger
QUERY_LOGGER_PASSWORD=

# --- Document storage (Phase 6) ---
# Azure Blob Storage connection string. "UseDevelopmentStorage=true" = local Azurite emulator.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
